# DataTether — Environment Variable Template
# ============================================
# Copy this file to .env and fill in your values.
# .env is git-ignored. This file (.env.example) is safe to commit.
# Never paste real credentials into this file.

# ──────────────────────────────────────────────────────────────────────────────
# Meta AI Integration
# ──────────────────────────────────────────────────────────────────────────────
# Official API key from api.meta.ai. Leave blank to use deterministic fallback.
MODEL_API_KEY=

# Legacy fallback name (MODEL_API_KEY takes precedence if both are set)
# META_AI_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Local MinIO Storage (S3-compatible, zero-cost, runs on Docker)
# ──────────────────────────────────────────────────────────────────────────────
# Leave all MINIO_ variables blank to use the curated demo dataset index instead.
# Set them only when you have a local MinIO container running.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_BUCKET=datatether-local-lake

# ──────────────────────────────────────────────────────────────────────────────
# AWS S3 (Optional — incurs AWS charges; use only with a real account)
# ──────────────────────────────────────────────────────────────────────────────
# Leave blank for zero-cost local development.
# boto3 will pick these up automatically when both key variables are set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
